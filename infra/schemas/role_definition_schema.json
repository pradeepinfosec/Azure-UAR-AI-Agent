{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AzureCustomRoleDefinition",
  "type": "object",
  "properties": {
    "Name": { "type": "string" },
    "IsCustom": { "type": "boolean" },
    "Description": { "type": "string" },
    "Actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "NotActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "DataActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "NotDataActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "AssignableScopes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["Name", "IsCustom", "Description", "Actions", "AssignableScopes"]
}
